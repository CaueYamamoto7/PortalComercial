# ---------------------------------------------------------------------------
# Portal Comercial — variáveis de ambiente
# Copie para .env (ou configure no painel da Vercel) e preencha os valores.
# ---------------------------------------------------------------------------

# Banco de dados Postgres (Neon, Aiven, etc.).
# Formato: postgres://usuario:senha@host/banco?sslmode=require
DATABASE_URL=

# Salt de segurança do CakePHP. Gere com:
#   php -r "echo bin2hex(random_bytes(32));"
SECURITY_SALT=

# Produção
APP_ENV=production
APP_FULL_BASE_URL=https://seu-dominio.com.br
DEBUG=false
SESSION_SECURE=true
SESSION_TIMEOUT=240
APP_TMP=/tmp/cake
APP_DEFAULT_TIMEZONE=America/Sao_Paulo

# Credenciais do administrador criadas pela migration SeedCatalog.
# Usadas apenas na primeira execução das migrations.
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@assinasoft.com.br
ADMIN_PASSWORD=troque-esta-senha

# Conector privado, acessível pelo backend e pelo worker (não pelo navegador).
WHATSAPP_CONNECTOR_URL=http://127.0.0.1:3100
WHATSAPP_CONNECTOR_TOKEN=
# IA opcional: escolha um modelo disponível no plano gratuito da sua conta.
GROQ_API_KEY=
GROQ_MODEL=
