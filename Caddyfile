{
	frankenphp

	# Evita tentar instalar o certificado local dentro do container.
	skip_install_trust
}

:{$PORT:80} {
	root * /app/public

	encode zstd gzip

	# API CakePHP: o front controller é backend/webroot/index.php e as rotas
	# já estão no escopo /api (backend/config/routes.php).
	handle /api/* {
		root * /app/backend/webroot
		php_server
	}

	# Front estático: páginas HTML, assets, imagens.
	handle {
		try_files {path} {path}/ /index.html
		file_server
	}

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
